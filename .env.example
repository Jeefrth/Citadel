# ===========================================
# srv_gest — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_USER=srv_gest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=srv_gest
DATABASE_URL=postgresql+asyncpg://srv_gest:changeme@db:5432/srv_gest

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Microsoft Entra ID ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# --- Security ---
CREDENTIAL_ENCRYPTION_KEY=generate-a-32-byte-base64-key

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:5173
SECRET_KEY=generate-a-random-secret-key

# --- Frontend (used at build time) ---
VITE_AZURE_TENANT_ID=your-tenant-id
VITE_AZURE_CLIENT_ID=your-client-id
VITE_API_URL=http://localhost:8000
