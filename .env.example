# ===========================================
# citadel — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_USER=citadel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=citadel
DATABASE_URL=postgresql+asyncpg://citadel:changeme@db:5432/citadel

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Microsoft Entra ID ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# --- Security ---
CREDENTIAL_ENCRYPTION_KEY=generate-a-32-byte-base64-key

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:5173
SECRET_KEY=generate-a-random-secret-key

# --- Frontend (used at build time) ---
VITE_AZURE_TENANT_ID=your-tenant-id
VITE_AZURE_CLIENT_ID=your-client-id
VITE_API_URL=http://localhost:8000

# --- Host port exposed for the backend (keep VITE_API_URL in sync) ---
BACKEND_PORT=8000

# --- Secrets vault (OpenBao / HashiCorp Vault, same API) ---
# local = AES-256-GCM with CREDENTIAL_ENCRYPTION_KEY (no vault)
# vault = Transit engine (key never leaves the vault); see docs/vault.md
SECRETS_BACKEND=vault
# local = CA key file in data/ca ; vault = SSH secrets engine signs certificates
CA_BACKEND=vault
# VAULT_ADDR=http://openbao:8200   (set by docker compose)
# External vault: VAULT_ROLE_ID / VAULT_SECRET_ID, VAULT_CACERT, VAULT_NAMESPACE

# --- Governance (ACL, approvals, notifications) ---
TIMEZONE=Europe/Zurich
PUBLIC_URL=http://localhost:5173
# CIDRs of reverse proxies whose X-Forwarded-For is trusted (prod compose sets it)
TRUSTED_PROXIES=
